APP_NAME="Honorari"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=hr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Bez DB_DATABASE koristi se database/database.sqlite ove instalacije.
# Za drugu lokaciju unesite vlastitu apsolutnu putanju.
DB_URL=

SESSION_DRIVER=database
SESSION_CONNECTION=sqlite
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=honorari_public_session

CACHE_STORE=database
DB_CACHE_CONNECTION=sqlite
DB_CACHE_LOCK_CONNECTION=sqlite
CACHE_PREFIX=honorari_public_

QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=sqlite
DB_QUEUE=honorari-public

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=honorari@example.test
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
